# ============================================================================
# Wordlish Tutoring · Variables de entorno de ejemplo
# ============================================================================
# Copia este archivo como `.env` y completa los valores reales cuando
# actives el backend. Nunca subas tu `.env` al repositorio.
#
# Todas las variables Expo expuestas al cliente deben comenzar con
# `EXPO_PUBLIC_`. Cualquier otra variable no llega al bundle.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend (OnSpace Cloud / Supabase-compatible)
# ---------------------------------------------------------------------------
# Las inyecta OnSpace Cloud automáticamente al build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Modo de autenticación (Fase 3A)
# ---------------------------------------------------------------------------
# 'mock' → Autenticación simulada en memoria con 5 correos de prueba y la
#          contraseña maestra 123456. Es el modo por defecto para que la
#          aplicación siga funcionando durante desarrollo aunque aún no
#          existan cuentas reales.
# 'real' → Autenticación real contra Supabase Auth con sesión persistente
#          y perfil sincronizado desde `public.user_profiles`. Requiere
#          que ya existan usuarios creados en el Dashboard de OnSpace
#          Cloud y que sus filas de perfil/actor estén asignadas
#          (ver docs/AUTH_MIGRATION.md).
#
# Cualquier valor distinto de 'real' equivale a 'mock'.
EXPO_PUBLIC_AUTH_MODE=mock

# ---------------------------------------------------------------------------
# WhatsApp de soporte (opcional)
# ---------------------------------------------------------------------------
# Número al que se abrirán los enlaces `wa.me` desde botones de soporte y
# alertas de asistencia. Formato E.164 sin signos ni espacios.
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# ---------------------------------------------------------------------------
# Zoom (pendiente de integración real)
# ---------------------------------------------------------------------------
# Hoy los botones "Abrir Zoom" usan un enlace estático. Cuando se integre
# OAuth de Zoom, estas variables permitirán generar salas por clase.
EXPO_PUBLIC_ZOOM_CLIENT_ID=
EXPO_PUBLIC_ZOOM_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Pagos (pendiente de integración real)
# ---------------------------------------------------------------------------
# Se completarán cuando se conecte la pasarela real (Stripe, Yappy, etc.).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Observabilidad (opcional)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_KEY=
